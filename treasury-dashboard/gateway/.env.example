# Copy to .env (in the folder you start the server from) to connect the AI assistant. Never commit real keys.
# If news-engine-v8/.env already has these, the gateway reads that file too.
OPENROUTER_API_KEY=
LLM_MODEL=google/gemini-3-flash-preview
LLM_BASE_URL=https://openrouter.ai/api/v1
# Shared data and immutable run records; defaults are relative to the workspace.
# MARKET_DATA_DB=E:/YTP-AIF/market-data-feed/market_data.sqlite
# TREASURY_STATE_DB=E:/YTP-AIF/market-data-feed/data/treasury.sqlite
# NEWS_V8_EXPORT_DIR=E:/YTP-AIF/market-data-feed/data/news-v8-exports
# Separate v8 service configuration is unnecessary with run_dashboard.py.
# NEWS_V8_URL=http://127.0.0.1:8000
# NEWS_API_TOKEN=
# DASHBOARD_API_TOKEN=
